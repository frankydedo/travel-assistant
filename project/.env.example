# Copia in .env (opzionale): senza nessuna chiave il sistema funziona con il provider mock deterministico.
# Il file .env è escluso da git: non committare mai le chiavi.

# Ordine della catena di fallback (ADR-0005). I provider senza credenziali vengono saltati;
# il mock è sempre l'ultimo anello.
LLM_CHAIN=groq,gemini,mock

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_REASONING_EFFORT=low

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low

# LLM_TIMEOUT_SECONDS=30
# LLM_COOLDOWN_SECONDS=60

# Logging (ADR-0017): JSON su stdout in Docker
# LOG_LEVEL=INFO

# Rate limit per utente sui messaggi di chat (ADR-0007)
# RATE_LIMIT_MESSAGES=20
# RATE_LIMIT_WINDOW_SECONDS=60
